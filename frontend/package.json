{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:content && tsc -b && vite build && node ../scripts/check-content.mjs --dist",
    "check:content": "node ../scripts/check-content.mjs",
    "lint": "cd .. && oxlint --config frontend/.oxlintrc.json --deny-warnings frontend scripts",
    "preview": "vite preview",
    "type-check": "tsc -b",
    "test": "node --test ../scripts/check-content.test.mjs && vitest run",
    "test:e2e": "playwright test --grep-invert \"视觉自查\"",
    "format": "prettier --config .prettierrc.json --write . ../scripts",
    "format:check": "prettier --config .prettierrc.json --check . ../scripts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.4",
    "konva": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-konva": "^19.2.5",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.12"
  }
}
